# Stock SDI Demo Frontend — template konfigurasi
#
# Salin ke `.env.local` lalu sesuaikan nilainya untuk development lokal.
# Semua nilai di file ini adalah placeholder (tanpa secret).
#
# Frontend sekarang 100% memakai REST API custom (auth cookie + data).
# Supabase sudah HAPUS dari dependency & runtime frontend.
#   Supabase browser client ------> HAPUS
#   @supabase/supabase-js ------> HAPUS dari package.json

# Base URL REST API (Node Express, loopback homelab :3101).
# - Dev lokal: http://localhost:3101 (sambungkan via tunnel SSH ke server)
# - Seluruh panggilan API memakai path di bawah base ini tanpa hardcode host.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3101

# Username akun demo "guest" untuk tombol "Masuk sebagai Tamu".
NEXT_PUBLIC_GUEST_USERNAME=tamu.demo

# (Opsional) daftar role tambahan yang dianggap read-only (pisahkan dengan koma).
# NEXT_PUBLIC_GUEST_ROLES=

# Catatan: credential API (DB/user demo) TIDAK pernah ada di frontend;
# dipegang server di /home/nugie/stock-sdi-api/.env dan .demo-users.json.
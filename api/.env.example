# ============================================================
# Stock SDI Demo API - contoh konfigurasi
# Salin ke file `.env` untuk pemakaian lokal:
#   cp .env.example .env
# JANGAN PERNAH commit file .env ke repository.
# ============================================================

# Port HTTP API (default dev: 3101, jangan tabrakan dengan belajar-node:3000
# atau kontainer Docker staging yang memakai 3001).
PORT=3101

# Koneksi PostgreSQL (homelab) — isi sesuai environment.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=stock_sdi_demo
DATABASE_USER=stock_sdi_demo_user
DATABASE_PASSWORD=ganti_dengan_password_nyata

# Origin yang diizinkan untuk CORS (bukan wildcard).
# Contoh dev frontend Next.js: http://localhost:3000
# Dapat berupa daftar dipisah koma bila deploy multi-frontend.
API_CORS_ORIGIN=http://localhost:3000

# ============================================================
# Autentikasi (custom, HttpOnly cookie-based)
# ============================================================

# Nama cookie sesi (HttpOnly, SameSite=Lax, Path=/).
COOKIE_NAME=hl_stock_demo_session

# Secure flag cookie HANYA saat HTTPS (production/domain). Dev loopback=false.
COOKIE_SECURE=false

# Umur sesi dalam jam (default 8).
SESSION_TTL_HOURS=8

# Proteksi brute-force login:
# - gagal login per (IP + username) dalam window
# - gagal login per IP (cekal enumerasi massal)
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_IP_MAX_ATTEMPTS=100